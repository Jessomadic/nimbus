    "stdout": "one JSON object",
    "exit_success": 0,
    "exit_failure": 1,
    "run_py_integration": "pending"
  },
  "manifest": {
    "additionalProperties": false,
    "required": [
      "request_id",
      "source_namespace",
      "source_document_id",
      "source_revision",
      "expected_published_revision",
      "sha256",
      "markdown_path",
      "title",
      "source_uri",
      "author_label",
      "published_by",
      "published_at",
      "citations"
