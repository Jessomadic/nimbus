      "store",
      "manifest",
      "input_root",
      "archive_root"
    ],
    "status": "PublicationStore.status(request_id)"
  },
  "cli": {
    "cwd": "installed knowledge_tools",
    "executable": "operator configured Python",
    "publish": [
      "-m",
      "kb.publication_cli",
      "--db",
      "DB",
      "--input-root",
      "INPUT",
      "--archive-root",
      "ARCHIVE",
      "publish-nimbus",
      "--request",
      "MANIFEST"
    ],
    "status": [
      "-m",
      "kb.publication_cli",
      "--db",
      "DB",
      "--input-root",
      "INPUT",
      "--archive-root",
      "ARCHIVE",
      "publication-status",
      "--request-id",
      "UUID"
