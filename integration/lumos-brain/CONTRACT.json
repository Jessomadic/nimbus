    "request_id": "canonical UUID; immutable payload per request",
    "source_namespace": "nimbus:<installation UUID>",
    "source_document_id": "canonical UUID",
    "source_revision": "integer >= 1",
    "expected_published_revision": "null or integer >= 1",
    "sha256": "lowercase SHA256 of exact UTF-8 Markdown bytes",
    "markdown_path": "operator-controlled absolute local allowlisted .md; <= 1000000 bytes",
    "source_uri": "nimbus://<installation UUID>/<document UUID>?rev=<revision>",
    "citations": "<=20 objects; record_id,fingerprint,quote required; locator optional"
