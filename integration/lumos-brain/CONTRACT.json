  "receipt": {
    "committed": [
      "request_id",
      "status",
      "namespace",
      "source_document_id",
      "revision",
      "sha256",
      "kb_document_id",
      "archive_path",
      "manifest_path",
      "previous_revision",
      "committed_at",
      "warnings"
    ],
    "status_values": [
      "committed",
      "not_committed"
    ],
    "not_committed": "NOT evidence that no writer is active"
  },
  "safety": [
    "No HTTP or write MCP publication endpoint",
    "No automatic retry on unknown outcome",
    "Reconcile by request_id before replay",
    "No Nimbus raw DB writes",
    "Indexed is not shared-retrieval verified",
    "Brain identity must resolve actual KB id/hash; never title"
