{
  "name": "nimbus",
  "version": "0.2.0",
  "description": "Windows AI worker team with shared local inference and OpenAI subscription execution",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings --env-file-if-exists=.env server.js",
    "test": "node --no-warnings --test --test-concurrency=1 tests/*.test.mjs",
    "doctor": "node --no-warnings --env-file-if-exists=.env bin/doctor.mjs",
    "browser:install": "playwright install chromium",
    "verify:live": "node --no-warnings --env-file-if-exists=.env bin/verify-live.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "archiver": "8.0.0",
    "playwright": "1.64.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "qrcodejs": "1.0.0"
  }
}
